{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "AulaIA local — SPA + API",
      "type": "dotnet",
      "request": "launch",
      "projectPath": "${workspaceFolder}/src/AulaIA.Api/AulaIA.Api.csproj",
      "launchSettingsProfile": "local-spa",
      "preLaunchTask": "5. Full Stack — Build completo: Web → wwwroot + API (default)",
      "serverReadyAction": {
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
        "uriFormat": "%s",
        "action": "openExternally"
      },
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    }
  ]
}
